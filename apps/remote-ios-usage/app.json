{
  "expo": {
    "name": "Usage Remote",
    "slug": "remote-ios-usage",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.chengfei.remoteiosusage",
      "supportsTablet": true,
      "buildNumber": "6"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
