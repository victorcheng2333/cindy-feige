{
  "name": "remote-mac-usage",
  "productName": "Quota Cat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "猫猫：独立的 macOS 远程订阅额度菜单栏应用",
  "dependencies": {
    "@cindy/auth-client": "workspace:*",
    "@cindy/device-link": "workspace:*",
    "@cindy/maker-shared": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/packager": "18.4.4",
    "@electron/osx-sign": "1.3.3",
    "@types/node": "*",
    "@types/ws": "^8.18.1",
    "electron": "42.11.12",
    "esbuild": "0.28.1",
    "playwright-core": "1.60.0",
    "sharp": "^0.35.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs --region cn",
    "start": "pnpm start:rust",
    "demo": "pnpm demo:rust",
    "start:electron": "pnpm build && electron dist",
    "demo:electron": "pnpm build && electron dist --demo",
    "verify:ui": "pnpm build && node scripts/verify-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "package": "node scripts/package-rust.mjs --region cn",
    "package:electron": "pnpm build && node scripts/package.mjs --region cn",
    "build:rust": "node scripts/build-rust-ui.mjs --region cn && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "start:rust": "pnpm build:rust && ./src-tauri/target/release/quota-cat-rust",
    "demo:rust": "pnpm build:rust && ./src-tauri/target/release/quota-cat-rust --demo",
    "test:rust": "node scripts/build-rust-ui.mjs --region cn && cargo test --manifest-path src-tauri/Cargo.toml",
    "package:rust": "node scripts/package-rust.mjs --region cn"
  }
}
