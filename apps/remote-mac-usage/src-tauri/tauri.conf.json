{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "猫猫",
  "version": "0.2.0",
  "identifier": "com.chengfei.quotacat.cn",
  "build": {
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "macOSPrivateApi": false,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "猫猫 · 远程额度",
        "width": 468,
        "height": 728,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Chengfei"
  }
}
